#include <Arduino.h>
#include <avr/pgmspace.h>

// Notas musicais utilizadas
#define NOTE_D4 294
#define NOTE_E4 330
#define NOTE_F4 349
#define NOTE_G4 392
#define NOTE_A4 440
#define NOTE_B4 494
#define NOTE_C5 523
#define NOTE_D5 587
#define NOTE_E5 659
#define NOTE_F5 698
#define REST 0

// Configuracoes
const int tempo = 108;
const int buzzer = 3;

// Melodia e duracao das notas
const int16_t melody[] PROGMEM = {

  // Song of Storms - Zelda Ocarina of Time

  NOTE_D4,4, NOTE_A4,4, NOTE_A4,4,
  REST,8, NOTE_E4,8, NOTE_B4,2,

  NOTE_F4,4, NOTE_C5,4, NOTE_C5,4,
  REST,8, NOTE_E4,8, NOTE_B4,2,

  NOTE_D4,4, NOTE_A4,4, NOTE_A4,4,
  REST,8, NOTE_E4,8, NOTE_B4,2,

  NOTE_F4,4, NOTE_C5,4, NOTE_C5,4,
  REST,8, NOTE_E4,8, NOTE_B4,2,

  NOTE_D4,8, NOTE_F4,8, NOTE_D5,2,
  NOTE_D4,8, NOTE_F4,8, NOTE_D5,2,

  NOTE_E5,-4, NOTE_F5,8,
  NOTE_E5,8, NOTE_E5,8,

  NOTE_E5,8, NOTE_C5,8, NOTE_A4,2,

  NOTE_A4,4, NOTE_D4,4,
  NOTE_F4,8, NOTE_G4,8,

  NOTE_A4,-2,

  NOTE_A4,4, NOTE_D4,4,
  NOTE_F4,8, NOTE_G4,8,

  NOTE_E4,-2,

  NOTE_D4,8, NOTE_F4,8, NOTE_D5,2,
  NOTE_D4,8, NOTE_F4,8, NOTE_D5,2,

  NOTE_E5,-4, NOTE_F5,8,
  NOTE_E5,8, NOTE_E5,8,

  NOTE_E5,8, NOTE_C5,8, NOTE_A4,2,

  NOTE_A4,4, NOTE_D4,4,
  NOTE_F4,8, NOTE_G4,8,

  NOTE_A4,2, NOTE_A4,4,

  NOTE_D4,1
};

// Quantidade de notas
const int notes =
  sizeof(melody) / sizeof(melody[0]) / 2;

// Duracao de uma nota inteira
const long wholenote = (60000L * 4) / tempo;

void tocarMusica() {

  for (int i = 0; i < notes * 2; i += 2) {

    // Le as notas da memoria Flash
    int frequencia =
      (int16_t)pgm_read_word(&melody[i]);

    int divisor =
      (int16_t)pgm_read_word(&melody[i + 1]);

    long duracao;

    // Calcula a duracao da nota
    if (divisor > 0) {
      duracao = wholenote / divisor;
    }
    else {
      // Notas pontuadas
      duracao = wholenote / abs(divisor);
      duracao = duracao * 3 / 2;
    }

    // Toca 90% da duracao da nota
    if (frequencia != REST) {
      tone(buzzer, frequencia, duracao * 9 / 10);
    }
    else {
      noTone(buzzer);
    }

    // Aguarda a duracao completa
    delay(duracao);

    // Para antes da proxima nota
    noTone(buzzer);
  }
}

void setup() {

  pinMode(buzzer, OUTPUT);

  // Toca a musica uma vez
  tocarMusica();
}

void loop() {
  // Nao repete a musica
}


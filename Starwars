
/*
  Star Wars - Main Theme
  Compositor: John Williams
  Codigo original: Robson Couto (2019)

  Adaptado para Arduino UNO
  Buzzer passivo no pino 3
*/

#include <Arduino.h>
#include <avr/pgmspace.h>

// Notas musicais utilizadas
#define NOTE_AS4 466
#define NOTE_C5 523
#define NOTE_D5 587
#define NOTE_E5 659
#define NOTE_F5 698
#define NOTE_G5 784
#define NOTE_GS5 831
#define NOTE_A5 880
#define NOTE_AS5 932
#define NOTE_C6 1047
#define NOTE_CS6 1109
#define NOTE_DS6 1245
#define NOTE_F6 1397
#define REST 0

// Configuracoes
const int tempo = 108;
const int buzzer = 3;

// Melodia e duracao das notas
const int16_t melody[] PROGMEM = {

  // Star Wars Main Theme

  NOTE_AS4,8, NOTE_AS4,8, NOTE_AS4,8,

  NOTE_F5,2, NOTE_C6,2,

  NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F6,2, NOTE_C6,4,

  NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F6,2, NOTE_C6,4,

  NOTE_AS5,8, NOTE_A5,8, NOTE_AS5,8,
  NOTE_G5,2,

  NOTE_C5,8, NOTE_C5,8, NOTE_C5,8,

  NOTE_F5,2, NOTE_C6,2,

  NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F6,2, NOTE_C6,4,

  // Parte 2

  NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F6,2, NOTE_C6,4,

  NOTE_AS5,8, NOTE_A5,8, NOTE_AS5,8,
  NOTE_G5,2,

  NOTE_C5,-8, NOTE_C5,16,

  NOTE_D5,-4, NOTE_D5,8,
  NOTE_AS5,8, NOTE_A5,8,
  NOTE_G5,8, NOTE_F5,8,

  NOTE_F5,8, NOTE_G5,8,
  NOTE_A5,8, NOTE_G5,4,

  NOTE_D5,8, NOTE_E5,4,
  NOTE_C5,-8, NOTE_C5,16,

  NOTE_D5,-4, NOTE_D5,8,
  NOTE_AS5,8, NOTE_A5,8,
  NOTE_G5,8, NOTE_F5,8,

  // Parte 3

  NOTE_C6,-8, NOTE_G5,16,
  NOTE_G5,2, REST,8, NOTE_C5,8,

  NOTE_D5,-4, NOTE_D5,8,
  NOTE_AS5,8, NOTE_A5,8,
  NOTE_G5,8, NOTE_F5,8,

  NOTE_F5,8, NOTE_G5,8,
  NOTE_A5,8, NOTE_G5,4,

  NOTE_D5,8, NOTE_E5,4,
  NOTE_C6,-8, NOTE_C6,16,

  NOTE_F6,4, NOTE_DS6,8,
  NOTE_CS6,4, NOTE_C6,8,

  NOTE_AS5,4, NOTE_GS5,8,
  NOTE_G5,4, NOTE_F5,8,

  NOTE_C6,1
};

// Quantidade de notas
const int notes =
  sizeof(melody) / sizeof(melody[0]) / 2;

// Duracao de uma nota inteira
const long wholenote = (60000L * 4) / tempo;

void tocarMusica() {

  for (int i = 0; i < notes * 2; i += 2) {

    // Le nota e duracao da memoria Flash
    int frequencia =
      (int16_t)pgm_read_word(&melody[i]);

    int divisor =
      (int16_t)pgm_read_word(&melody[i + 1]);

    long duracao;

    // Calcula a duracao da nota
    if (divisor > 0) {
      duracao = wholenote / divisor;
    }
    else {
      // Notas pontuadas
      duracao = wholenote / abs(divisor);
      duracao = duracao * 3 / 2;
    }

    // Toca por 90% da duracao
    if (frequencia != REST) {
      tone(buzzer, frequencia, duracao * 9 / 10);
    }
    else {
      noTone(buzzer);
    }

    // Aguarda a duracao completa
    delay(duracao);

    // Interrompe antes da proxima nota
    noTone(buzzer);
  }
}

void setup() {
  pinMode(buzzer, OUTPUT);

  // Toca a musica uma vez
  tocarMusica();
}

void loop() {
  // Nao repete a musica
}
